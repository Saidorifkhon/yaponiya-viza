# --- Namuna: bir nechta akkaunt (har xil odam), vergul bilan, LOGIN_ID tartibida ---
# LOGIN_ID=majidovsaidorif,ikkinchi_login
# PASSWORD=parol1,parol2
# APPLICANT_NAME=Saidorif Majidov,Ikkinchi Odam
# PHONE=+998901112233,+998904445566
# PASSPORT_NO=AA1234567,AB7654321
# EMAIL=birinchi@mail.uz,ikkinchi@mail.uz
# Bitta qiymat yozilsa hammaga bir xil ishlatiladi. Ismda vergul ishlatmang.

# Nusxa oling: copy .env.example .env  va qiymatlarni to'ldiring. .env git ga tushmaydi.
# Parolni faqat .env ga yozing, bu faylga emas.
# Bir nechta akkaunt bo'lsa vergul bilan, bir xil tartibda (parolda vergul bo'lmasin):
#   LOGIN_ID=login1,login2
#   PASSWORD=parol1,parol2
# Har bir akkaunt uchun alohida brauzer ochiladi, har biri o'z navbatini olguncha
# mustaqil ishlaydi (biri olsa ham qolganlari davom etadi).
LOGIN_ID=
PASSWORD=

# Navbat ochiladigan vaqt (kompyuter vaqti, HH:MM). Skript LEAD_MINUTES daqiqa oldin boshlaydi.
START_TIME=19:00
LEAD_MINUTES=5
# START_TIME dan necha daqiqa o'tgach kuzatuv to'xtaydi (bloklanmaslik uchun).
STOP_AFTER_MINUTES=10

# Kalendarni qayta tekshirish oralig'i (soniya). 1 dan kam bo'lsa skript 1 qiladi.
POLL_SECONDS=1
# START_TIME dan 1 daqiqa oldingacha (kutish vaqtida) yangilash oralig'i, soniya.
PRE_POLL_SECONDS=20

# Ariza turi (kalendar formasidagi yashirin category/event/plan).
# 12/20/19 = "VISA Application for short stay (Applicant)". COE yoki
# Government Documents bo'lsa saytdagi mos qiymatlarni yozing.
CATEGORY_ID=12
EVENT_ID=20
PLAN_ID=19

# Nechta oyni tekshirish: 1 = joriy oy, 2 = keyingi oy ham.
MONTHS=1

# Ixtiyoriy: aniq CSS selektor (masalan: td.ok a) - bo'sh qolsa a.js_move_reserve ishlatiladi.
SLOT_SELECTOR=

# Ixtiyoriy: faqat shu matn bor slotni tanlash (masalan ma'lum sana "25").
PREFER_TEXT=

# --- Ariza formasi (slot bosilgandan keyin chiqadi). Bir nechta akkaunt bo'lsa
# har bir maydonni vergul bilan LOGIN_ID tartibida yozing: PHONE=+998901112233,+998904445566
# (ismda vergul ishlatmang). Bo'sh qolgan majburiy
# maydon bo'lsa skript to'xtab ovoz beradi, qo'lda to'ldirasiz. ---
APPLICANT_NAME=
FIRST_NAME=
LAST_NAME=
NAME_KANA=
PHONE=
EMAIL=
PASSPORT_NO=
BIRTH_DATE=
NATIONALITY=
ADDRESS=
PURPOSE=
REMARKS=
# Aniq maydon nomi ma'lum bo'lsa: name=qiymat;name2=qiymat2  (akkauntlar orasida ||)
FORM_FIELDS=
# 1 = majburiy rozilik checkbox ini avtomatik belgilash
AGREE_CHECKBOX=1

# 1 = brauzer ko'rinmaydi. Tavsiya: 0 (ko'rinsin, kerak bo'lsa qo'lda davom etasiz).
HEADLESS=0
